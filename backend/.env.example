# ============================================================================
# TRILINGUO / NYOB ZOO — PRODUCTION BACKEND CONFIGURATION (.env.example)
# ============================================================================

# 1. APPLICATION & FRONTEND URLS
APP_NAME="Trilinguo NYOB ZOO API"
APP_ENV="production"
BACKEND_BASE_URL="http://localhost:8000"
FRONTEND_BASE_URL="http://localhost:8000"

# 2. DATABASE CONNECTION (Supabase PostgreSQL or Local SQLite Fallback)
# Example Supabase PostgreSQL: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL="sqlite:///./trilinguo_production.db"

# 3. JWT SECURITY CONFIGURATION
JWT_SECRET_KEY="trilinguo-nyob-zoo-tavan-super-secret-jwt-key-2026-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 4. GOOGLE OAUTH2 (Google Cloud Console -> APIs & Services -> Credentials)
# Scope required: openid email profile
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/auth/google/callback"

# 5. FACEBOOK OAUTH2 (Meta for Developers -> Facebook Login)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:8000/api/auth/facebook/callback"

# 6. GMAIL SMTP (Google Account -> Security -> 2-Step Verification -> App Passwords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="NYOB ZOO · Trilinguo Tả Van"

# 7. SMS / ZALO OTP GATEWAY (Optional Webhook/API for Phone OTP)
SMS_GATEWAY_URL=""
SMS_GATEWAY_API_KEY=""
OTP_TTL_SECONDS=300
