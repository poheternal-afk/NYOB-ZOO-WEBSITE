# ============================================================================
# TRILINGUO / NYOB ZOO — ENVIRONMENT TEMPLATE (.env.example)
# Copy file này thành .env và thay đổi DATABASE_URL / JWT_SECRET_KEY của bạn
# ============================================================================

APP_NAME="Trilinguo NYOB ZOO API"
APP_ENV="production"

# 1. DATABASE CONNECTION (Supabase PostgreSQL 24/7 hoặc Local SQLite Fallback)
# Ví dụ PostgreSQL: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL="sqlite:///./trilinguo_production.db"

# 2. JWT SECURITY CONFIGURATION
JWT_SECRET_KEY="thay_bang_chuoi_bi_mat_ngau_nhien_cua_ban"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
