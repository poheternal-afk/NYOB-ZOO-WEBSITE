{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/(index|phrase|vocabulary|quiz|profile)\\.html",
      "destination": "/frontend/$1.html"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/frontend/assets/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/frontend/js/$1"
    }
  ]
}
